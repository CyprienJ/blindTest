@startuml Component Architecture
' Decisions: ADR-0001 modular monolith; ADR-0002 server authority;
' ADR-0003 STOMP; ADR-0004 SessionStore; ADR-0005 private S3;
' ADR-0006 PostgreSQL history snapshots.
skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam ArrowColor #555555
skinparam component {
  BorderColor #888888
  BackgroundColor #FFFFFF
}

package "Browser (Angular)" {
  [Auth Module] as auth_fe
  [Lobby Module] as lobby_fe
  [Game Module] as game_fe
  [Admin Module] as admin_fe
  [Friends / Profile] as friends_fe
  [NotificationService] as notif_fe
}

package "Backend (Spring Boot :8080)" {
  package "Web Layer" {
    [REST Controllers\n/api/**] as rest
    [WebSocket / STOMP\n/ws] as ws
  }

  package "Service Layer" {
    [AuthService] as auth_svc
    [SessionService] as session_svc
    [GameService] as game_svc
    [FriendService] as friend_svc
    [TrackService] as track_svc
    [PlaylistService] as playlist_svc
    [ImportJobService] as import_svc
    [HistoryService] as history_svc
    [NotificationService] as notif_svc
    [EmailService] as email_svc
  }

  package "Infrastructure" {
    interface "SessionStore port" as store_port
    [InMemorySessionStore\n(V1 adapter)] as store
    interface "GameEventPublisher port" as event_port
    [Spring STOMP adapter] as stomp_adapter
    [ScheduledExecutorService\n(round timers)] as scheduler
    [YtDlpWrapper\n(yt-dlp + FFmpeg)] as ytdlp
    interface "MediaStorage port" as media_port
    [MinIO S3 adapter] as minio_adapter
  }
}

database "PostgreSQL :5432" as pg {
  [users]
  [tracks]
  [playlists]
  [friend_requests]
  [game_history]
  [game_history_rounds]
  [track_import_jobs]
}

cloud "MinIO\nprivate S3-compatible bucket" as media

cloud "External Services" {
  [YouTube] as yt
  [SMTP (mail)] as smtp
}

' --- Frontend to Backend ---
auth_fe -right-> rest
lobby_fe -right-> rest
game_fe -right-> rest
admin_fe -right-> rest
friends_fe -right-> rest

game_fe -right-> ws
lobby_fe -right-> ws
notif_fe -right-> ws

' --- Internal Routing ---
rest --> auth_svc
rest --> session_svc
rest --> friend_svc
rest --> track_svc
rest --> playlist_svc
rest --> import_svc

ws --> game_svc
ws --> session_svc
ws --> notif_svc

' --- Service Logic ---
game_svc --> scheduler
game_svc --> store_port
session_svc --> store_port
store_port <|.. store
game_svc --> event_port
session_svc --> event_port
event_port <|.. stomp_adapter
stomp_adapter --> ws
notif_svc --> event_port
friend_svc --> notif_svc
import_svc --> ytdlp
game_svc --> history_svc : "completed snapshot"

' --- Persistence ---
auth_svc --> pg
friend_svc --> pg
track_svc --> pg
playlist_svc --> pg
import_svc --> pg
history_svc --> pg

' --- Infrastructure to External ---
ytdlp -down-> yt
ytdlp -down-> media_port : "validated temporary file"
media_port <|.. minio_adapter
minio_adapter -down-> media
email_svc -right-> smtp
auth_svc --> email_svc

legend bottom
  Architecture decisions:
  [[../adr/0001-modular-monolith.md ADR-0001]] modular monolith
  [[../adr/0002-server-authoritative-sessions.md ADR-0002]] server-authoritative sessions
  [[../adr/0003-stomp-for-game-events-from-v1.md ADR-0003]] STOMP from V1
  [[../adr/0004-in-memory-session-store.md ADR-0004]] in-memory SessionStore adapter
  [[../adr/0005-private-s3-media-and-presigned-playback.md ADR-0005]] private S3 media
  [[../adr/0006-postgresql-history-snapshots.md ADR-0006]] PostgreSQL history snapshots
endlegend

@enduml
