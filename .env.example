# Copy this file to .env and fill in the values before running docker compose.
# .env is git-ignored — never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────
POSTGRES_DB=blindtest
POSTGRES_USER=blindtest
POSTGRES_PASSWORD=change_me_strong_password

# ── JWT ─────────────────────────────────────────────────────────────────
# Must be at least 32 ASCII characters (256 bits) for HS256.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_32_chars_minimum_secret_key_here!!

# ── App ─────────────────────────────────────────────────────────────────
APP_BASE_URL=https://nosblindtests.fr
# Comma-separated browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=https://nosblindtests.fr
# Port that system nginx will proxy to (localhost only, not exposed to the internet)
APP_PORT=8090
# Per-import temporary workspace, wall-clock limit, and maximum accepted MP3 size (25 MiB).
APP_IMPORT_TEMP_DIR=/tmp/blindtest-imports
APP_IMPORT_MAX_SIZE_BYTES=26214400
APP_IMPORT_TIMEOUT=10m
# Docker CPU quota for the backend and its yt-dlp/FFmpeg child processes.
BACKEND_CPU_LIMIT=1.0
# Process-local gameplay retention and maintenance cadence.
APP_SESSION_INACTIVE_TTL=30m
APP_SESSION_FINISHED_TTL=5m
APP_SESSION_CLEANUP_DELAY=PT1M

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare Turnstile ─────────────────────────────────────────────────
# Real secret paired with the public site key compiled into environment.prod.ts.
# docker-compose.local.yml overrides this with Cloudflare's public test secret.
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ── Private S3-compatible media storage ─────────────────────────────────
# Internal API endpoint and browser-reachable HTTPS endpoint.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://media.example.com
S3_REGION=us-east-1
S3_BUCKET=blindtest-media
# These credentials bootstrap local MinIO. Production least-privilege credentials
# are introduced by the secrets-management roadmap ticket.
S3_ACCESS_KEY=change_me_s3_access_key
S3_SECRET_KEY=change_me_s3_secret_key
# Production startup accepts a positive duration no longer than 15 minutes.
S3_PRESIGNED_URL_TTL=5m
MEDIA_DELETION_POLL_DELAY_MS=30000
# Both ports bind to localhost only. The public media endpoint is reverse-proxied.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
